# Coditu — copy to .env.local and fill in.
#
# Local development runs the whole Supabase stack in Docker on the 544xx port
# block (the default 543xx is taken by another project on at least one machine).
#   npm run db:start   -> prints these values
#   npm run db:reset   -> applies every migration and reseeds
#   npm run db:test    -> the RLS assertions

# --- public: inlined into the client bundle ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The canonical origin, used for metadata, canonical URLs, OG images, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The VAPID PUBLIC key, and it is public on purpose: the browser has to hand it
# to `pushManager.subscribe()`, so it is in the bundle by definition. It is the
# identity a push service checks the signature against — useless without the
# private half, which is below and never leaves the server.
#
# Generate the pair once, with the library that uses it:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- server only: NEVER prefix with NEXT_PUBLIC_ ----------------------------
# Bypasses RLS completely. Referenced only from lib/supabase/admin.ts, which is
# `server-only`, and used only by the seed and the signed-URL issuer.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the short-lived token the PDF route handler uses to render the report
# through headless Chromium. Any long random string.
REPORT_TOKEN_SECRET=

# --- Web Push ---------------------------------------------------------------
# The private half of the VAPID pair above. It signs the JWT that authorises
# this application to a push service; anyone holding it can send notifications
# to every device subscribed to this deployment.
VAPID_PRIVATE_KEY=

# Who to contact if this application starts misbehaving toward a push service.
# `mailto:` or `https:`; the RFC requires one and the services enforce it.
VAPID_SUBJECT=mailto:hello@coditu.com

# All three are OPTIONAL. With any of them missing, push is simply off: the
# Settings control says so in words and `postComment` skips sending. Nothing
# throws, because a comment must never fail to save over a notification.

# Optional. The PDF route drives a headless Chromium; leave this empty to use
# the one `npx playwright install chromium` puts on the machine. A serverless
# host needs an explicit path — see docs/04-EXPORT-SPEC.md. When Chromium is
# missing the route returns 503 with the fix in the body; the report itself
# still opens in the browser and prints.
CHROMIUM_EXECUTABLE_PATH=

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# The hosted Supabase project's values go in `.env.production.local`, NOT here
# and NOT in `.env.local`. Next loads that file only when NODE_ENV=production,
# which keeps `npm run dev` and the entire test suite on the local stack.
#
# That separation is a safety property, not tidiness: the e2e suite inserts and
# deletes work items, and `scripts/with-prod-server.sh` refuses to start if
# NEXT_PUBLIC_SUPABASE_URL is not local — because it runs `next build`, which
# would otherwise pick up the production file.
#
# On a host (Vercel and friends) set the same four variables as project
# environment variables; there is no file to upload.

