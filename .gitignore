# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright
*.lighthouseci
/.lighthouseci

# next.js
/.next/
/out/

# production
/build

# macOS — AppleDouble resource forks and Finder metadata.
# These break `git status` with "non-monotonic index" when they land in .git/objects/pack.
._*
.DS_Store

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase local stack
/supabase/.branches
/supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent/tooling state — never committed
/.claude-flow
/.swarm
/.hive-mind
/.claude

# local screenshot helper — verification only, never committed
/scripts/.shot.local.mjs

# Client-portal browser verification — specs and fixtures are local-only until
# they are explicitly asked for in git. They run, they gate the work, and they
# are not committed.
/e2e/client-*.spec.ts
/e2e/client-fixtures.local.ts
/scripts/.*.local.mjs
